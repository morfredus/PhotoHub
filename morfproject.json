{
  "schema_version": 1,
  "project": { "id": "PhotoHub", "type": "application" },
  "packaging": {
    "provider": "project",
    "targets": {
      "windows-x86_64-zip": {
        "platform": { "os": "windows", "arch": "x86_64" },
        "build": { "preset": "mingw" },
        "package": { "script": "scripts/windows/package-win.ps1", "format": "zip", "ci": { "workflow": "packages.yml", "artifact": "photohub-windows", "file": "PhotoHub-{version}-win64.zip" } }
      },
      "windows-x86_64-installer": {
        "platform": { "os": "windows", "arch": "x86_64" },
        "build": { "preset": "mingw" },
        "package": { "script": "scripts/windows/package-win.ps1", "format": "exe", "ci": { "workflow": "packages.yml", "artifact": "photohub-windows", "file": "PhotoHub-{version}-win64-setup.exe" } }
      }
    }
  }
}
